PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Replace this with your PRIVATE Atlas database-user URI to share team data.
# This default is only for a separately installed local MongoDB server.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=mtow
SESSION_TIMEOUT=3600
# Optional: use 4 ONLY if `npm.cmd run diagnose` shows IPv4 succeeds.
# MONGODB_FAMILY=4
